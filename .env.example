# Application Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/personal_finance

# Authentication Security
JWT_SECRET=super_secure_jwt_secret_key_minimum_32_characters_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secure_refresh_secret_key_minimum_32_characters_2026
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP (Optional for local testing - logs to console if omitted)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@financehub.com

# Client Origin
CLIENT_URL=http://localhost:3000
